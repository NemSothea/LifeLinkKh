<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>kh.lifelink</groupId>
    <artifactId>lifelink-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>lifelink-api</name>
    <description>LifeLink KH — blood donor matching API</description>

    <properties>
        <java.version>21</java.version>
        <!-- Docker Engine API version Testcontainers talks. docker-java 3.4.2
             defaults to 1.32, which Docker Engine 29 rejects with HTTP 400 —
             it reports MinAPIVersion 1.40. Testcontainers reads that 400 as
             "no Docker here" and *skips* the schema tests instead of failing,
             so the build stays green while testing nothing. 1.44 is Docker
             25.0 and up. Override for an older engine:
             ./mvnw verify -Ddocker.api.version=1.43 -->
        <docker.api.version>1.44</docker.api.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Verifies Google ID tokens. Deliberately not a hand-rolled JWT parse: the
             Admin SDK pins RS256, fetches and caches Google's JWKS, honours key
             rotation and checks exp/iat. Hand-rolling that is where TM-AUTH-001 T1
             (algorithm confusion, alg:none) comes from. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.4.3</version>
        </dependency>

        <!-- Our own session JWT. Separate concern from the above: that library reads
             Google's tokens, this one issues ours. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Integration tests run against a real PostgreSQL. H2 is deliberately not
             used: it has no gen_random_uuid(), different CHECK semantics and no
             TIMESTAMPTZ, so a green H2 test would be a false pass on exactly what
             this layer exists to catch (docs/qa/test-strategy.md). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Makes the formatting rule in docs/tech-lead/coding-standards.md
                 executable. AOSP variant = 4-space indent, 100 columns. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.44.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- `api.version` is read by docker-java, which Testcontainers uses to
                 reach the daemon. It has to be set on the forked test JVM, not the
                 Maven one. argLine is deliberately not set here — JaCoCo owns it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Enforces the coverage floor from docs/qa/test-strategy.md: 70% line
                 coverage on logic classes. Config, the application class, entities,
                 repositories and DTOs are excluded — a percentage over generated
                 accessors and declarative config measures nothing. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <excludes>
                        <exclude>**/config/**</exclude>
                        <exclude>**/LifelinkApiApplication.class</exclude>
                        <exclude>**/*Repository.class</exclude>
                        <exclude>**/user/User.class</exclude>
                        <exclude>**/donor/DonorProfile.class</exclude>
                        <exclude>**/hospital/Hospital.class</exclude>
                        <exclude>**/request/BloodRequest.class</exclude>
                        <exclude>**/match/RequestMatch.class</exclude>
                        <exclude>**/donation/Donation.class</exclude>
                        <exclude>**/common/audit/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-and-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
