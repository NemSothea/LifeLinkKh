rules_version = '2';

// ADR 0009 — these rules are the only thing between a client and the data. Every rule here has a
// test in rules-tests/; docs/tech-lead/firestore-data-model.md says why each one exists.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Principals ──────────────────────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // The portal's one role (v1 has no hospital staff): a custom claim set only by the Admin SDK,
    // never a field a client can write — and the claim must agree with admins/{uid}, written in the
    // same step. A claim alone would outlive a revoke by up to an hour (an ID token is not re-read
    // until it expires); the record is read on every request, so removing it ends access at once.
    function adminPath() { return /databases/$(database)/documents/admins/$(uid()); }
    function isAdmin() {
      return signedIn()
          && request.auth.token.role == 'ADMIN'
          && exists(adminPath());
    }

    // ── Values ──────────────────────────────────────────────────────────────────────────────────
    function bloodTypes() { return ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']; }
    function isName(s, max) { return s is string && s.trim().size() > 0 && s.size() <= max; }
    function incoming() { return request.resource.data; }
    function changed() { return incoming().diff(resource.data).affectedKeys(); }

    // ── users/{uid} ─────────────────────────────────────────────────────────────────────────────
    function validUser(d) {
      return d.keys().hasOnly(['displayName', 'language', 'role', 'fcmToken', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['language', 'role', 'createdAt', 'updatedAt'])
          && (!('displayName' in d) || d.displayName == null || isName(d.displayName, 120))
          && d.language in ['km', 'en']
          && d.role in ['DONOR', 'REQUESTER']
          && (!('fcmToken' in d) || d.fcmToken == null || (d.fcmToken is string && d.fcmToken.size() <= 4096))
          && d.updatedAt == request.time;
    }
    match /users/{userId} {
      allow read: if (signedIn() && uid() == userId) || isAdmin();
      allow create: if signedIn() && uid() == userId
          && validUser(incoming()) && incoming().createdAt == request.time;
      allow update: if signedIn() && uid() == userId
          && validUser(incoming()) && incoming().createdAt == resource.data.createdAt;
      allow delete: if false;

      // ── users/{uid}/notifications/{id} — the bell's inbox ─────────────────────────────────
      // Filed only by the portal's server beside each push (push.js fileInInbox). The owner reads
      // it and marks entries read — one field, stamped with the server's clock, never cleared.
      // Nothing else: an entry is a record of a push that went out, so the owner cannot forge,
      // reword or delete one. Not even an admin reads it.
      match /notifications/{notificationId} {
        allow read: if signedIn() && uid() == userId;
        allow update: if signedIn() && uid() == userId
            && resource.data.readAt == null
            && changed().hasOnly(['readAt'])
            && incoming().readAt == request.time;
        allow create, delete: if false;
      }
    }

    // ── donors/{uid} ────────────────────────────────────────────────────────────────────────────
    function validCoordinates(d) {
      // ADR 0003: declining GPS is allowed, so all three are null — or all three are set. Seven
      // geohash characters is a cell of about 150 m, what the app sends with coordinates rounded
      // to three decimals; anything finer is a sharper point on a person's home than matching
      // needs (SEC-REVIEW-003 F-12, tightened by SEC-REVIEW-005 M-04).
      return (d.lat == null && d.lng == null && d.geohash == null)
          || (d.lat is number && d.lat >= -90 && d.lat <= 90
              && d.lng is number && d.lng >= -180 && d.lng <= 180
              && d.geohash is string && d.geohash.size() > 0 && d.geohash.size() <= 7);
    }
    function validDonor(d) {
      // `sex` (DEC-019) is allowed but not required: a profile saved before it existed, or by an
      // older APK, has no such key, and matching gives it the longer 120-day interval.
      return d.keys().hasOnly(['fullName', 'bloodType', 'districtCode', 'lastDonationDate',
                               'isAvailable', 'lat', 'lng', 'geohash', 'sex',
                               'createdAt', 'updatedAt'])
          && d.keys().hasAll(['fullName', 'bloodType', 'districtCode', 'lastDonationDate',
                              'isAvailable', 'lat', 'lng', 'geohash', 'createdAt', 'updatedAt'])
          && isName(d.fullName, 120)
          && d.bloodType in bloodTypes()
          && d.districtCode is string && d.districtCode.size() <= 16
          && exists(/databases/$(database)/documents/districts/$(d.districtCode))
          && (d.lastDonationDate == null
              || (d.lastDonationDate is timestamp && d.lastDonationDate <= request.time))
          && d.isAvailable is bool
          && (!('sex' in d) || d.sex == null || d.sex in ['M', 'F'])
          && validCoordinates(d)
          && d.updatedAt == request.time;
    }
    // SEC-REVIEW-003 F-04: what sets a donor's cooldown cannot be rolled back by the donor. Once
    // there is a last donation it stays set and only moves later — a day of slack for a phone
    // whose midnight is not Phnom Penh's, far short of the 56-day minimum. Once `sex` is given
    // it stays (F→M would shorten the interval from 120 to 90 days); a mistake is the admin's to
    // correct. Matching reads both (matching.js), so a donor must not be able to reset them.
    function keepsCooldown(before, after) {
      return (before.lastDonationDate == null
              || (after.lastDonationDate != null
                  && after.lastDonationDate >= before.lastDonationDate - duration.value(1, 'd')))
          && (!('sex' in before) || before.sex == null
              || ('sex' in after && after.sex == before.sex));
    }
    match /donors/{donorId} {
      // Nobody else — not a requester, not the admin portal. Matching reads it with the Admin SDK.
      allow read: if (signedIn() && uid() == donorId) || isAdmin();
      allow create: if signedIn() && uid() == donorId
          && validDonor(incoming()) && incoming().createdAt == request.time;
      allow update: if signedIn() && uid() == donorId
          && validDonor(incoming()) && incoming().createdAt == resource.data.createdAt
          && keepsCooldown(resource.data, incoming());
      allow delete: if false;
    }

    // ── requests/{requestId} ────────────────────────────────────────────────────────────────────
    function isCreatorOf(requestId) {
      return signedIn()
          && get(/databases/$(database)/documents/requests/$(requestId)).data.createdBy == uid();
    }
    function hasAccepted(requestId) {
      let matchPath = /databases/$(database)/documents/matches/$(requestId + '_' + uid());
      return signedIn() && exists(matchPath) && get(matchPath).data.response == 'ACCEPTED';
    }
    // SEC-REVIEW-003 F-19: an accepted donor needs the family's number while they can still
    // help — the request is open, or just filled and they may be on their way. Once it is
    // cancelled or has expired, the number is no longer theirs to keep reading.
    function stillReachable(requestId) {
      return get(/databases/$(database)/documents/requests/$(requestId)).data.status
          in ['OPEN', 'FULFILLED'];
    }

    match /requests/{requestId} {
      // The public board (DEC-009). Nothing private lives on this document — but a request an
      // admin has not approved yet, or rejected, is not on it (DEC-015): only its creator and
      // the admin see those. A query must say which statuses it wants for this to answer it.
      allow read: if resource.data.status in ['OPEN', 'FULFILLED', 'CANCELLED', 'EXPIRED']
          || (signedIn() && resource.data.createdBy == uid())
          || isAdmin();
      // Posting is the portal's createRequest (ADR 0010): the shape check this rule used to make
      // is there now, with the rate limit and the hospital's name, before anything is visible.
      allow create: if false;
      // The creator may cancel a pending or open request, and change nothing else. Approving and
      // rejecting are the portal's reviewRequest (DEC-015).
      allow update: if signedIn() && resource.data.createdBy == uid()
          && resource.data.status in ['PENDING', 'OPEN']
          && incoming().status == 'CANCELLED'
          && incoming().updatedAt == request.time
          && changed().hasOnly(['status', 'updatedAt']);
      allow delete: if false;

      // RequestViews' requesterContact: the creator, and a donor who accepted — nobody else.
      match /private/contact {
        allow read: if isCreatorOf(requestId)
            || (hasAccepted(requestId) && stillReachable(requestId))
            || isAdmin();
        // Written by createRequest in the same batch as the request (ADR 0010).
        allow create: if false;
        allow update, delete: if false;
      }

      // The board's accepted-donor list. Written by onMatchAnswered only.
      match /acceptedDonors/{donorUid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── matches/{requestId_donorUid} ────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if (signedIn() && resource.data.donorUid == uid()) || isAdmin();
      // Only the portal's reviewRequest creates one, so only matched donors have a match (ADR 0008).
      allow create, delete: if false;
      // The answer is the portal's respondToMatch (ADR 0010), which enforces what this rule did:
      // one answer, never overwritten (FR-REQUEST-004 deferred), only while the request is open.
      allow update: if false;
    }

    // ── reports/{requestId_reporterUid} ─────────────────────────────────────────────────────────
    // DEC-019: a donor who was alerted to a request can flag it (asked for money, looked fake,
    // harassment). One report per donor per request: the id is the donor's match id, so a
    // second report is an update, and updates are refused. Only the admin reads them.
    function reportReasons() { return ['MONEY', 'FAKE', 'HARASSMENT', 'OTHER']; }
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
          && incoming().keys().hasOnly(['requestId', 'reporterUid', 'reason', 'note', 'createdAt'])
          && incoming().keys().hasAll(['requestId', 'reporterUid', 'reason', 'note', 'createdAt'])
          && incoming().requestId is string
          && reportId == incoming().requestId + '_' + uid()
          && incoming().reporterUid == uid()
          && incoming().reason in reportReasons()
          && (incoming().note == null
              || (incoming().note is string && incoming().note.size() <= 500))
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/matches/$(reportId));
      allow update, delete: if false;
    }

    // ── donations/{donationId} ──────────────────────────────────────────────────────────────────
    match /donations/{donationId} {
      allow read: if (signedIn() && resource.data.donorUid == uid()) || isAdmin();
      // confirmDonation only — it also writes lastDonationDate, which must move with it.
      allow write: if false;
    }

    // ── admins/{uid} ────────────────────────────────────────────────────────────────────────────
    // The second half of isAdmin(). Written only by firebase/seed/admin.mjs (Admin SDK), which sets
    // the claim in the same run. Deleting the record is how an admin's access is ended.
    match /admins/{adminUid} {
      allow read: if signedIn() && uid() == adminUid;
      allow write: if false;
    }

    // ── config/app ──────────────────────────────────────────────────────────────────────────────
    // What the app needs before anyone signs in: the newest build, the oldest one still allowed,
    // and where to download it (the APK is sideloaded, so the app cannot rely on a store to
    // update itself). Written only with the Admin SDK: the portal's setAppConfig function (which
    // checks for an admin) or scripts/release.mjs — never directly by a client, admin included.
    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    // ── Reference data ──────────────────────────────────────────────────────────────────────────
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if false;
    }
    match /districts/{code} {
      allow read: if true;
      allow write: if false;
    }
  }
}
