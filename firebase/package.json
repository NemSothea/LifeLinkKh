{
  "name": "lifelink-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-lifelink \"vitest run\"",
    "emulators": "firebase emulators:start --project demo-lifelink",
    "seed": "node seed/seed.mjs",
    "test:seed": "firebase emulators:exec --only firestore --project demo-lifelink \"node seed/seed.mjs && node seed/verify.mjs\"",
    "emulators:app": "firebase emulators:start --only firestore --project lifelinkkh",
    "seed:app": "node seed/seed.mjs --project lifelinkkh --emulator"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "geofire-common": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
