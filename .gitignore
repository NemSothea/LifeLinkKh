# OS
.DS_Store

# Secrets / env
.env
.env.*
# ...but the template of variable NAMES is committed on purpose. Without this negation
# the `.env.*` rule above silently swallows it.
!.env.example
*.local

# Firebase service-account keys. These carry an RSA private key that can mint
# credentials for the whole project, so this block exists BEFORE the Firebase
# project does — a key committed once is compromised for good and has to be
# revoked in the console, not merely deleted from the tree.
# Console downloads land as `<project>-firebase-adminsdk-<hash>-<hash>.json`;
# the other two patterns catch the names people rename them to.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
# Where the runbook tells you to put it. Ignored wholesale, so anything dropped
# here is safe by default even if it is named something unexpected. `secrets/*`
# rather than `secrets/`: git does not descend into an ignored directory, so the
# trailing-slash form makes the README negation below unreachable.
secrets/*
!secrets/README.md

# NOTE: mobile/android/app/google-services.json is deliberately NOT ignored. It is
# client configuration, not a secret — the Android API key in it is restricted by
# package name and SHA-1 fingerprint, and the release build in CI needs the file
# present. The private key above is the file that must never be committed.

# NOTE: mobile/ios/Runner/GoogleService-Info.plist is deliberately NOT ignored,
# same reasoning as the Android file above — the iOS API key in it is restricted
# by bundle ID in Google Cloud Console, and the build needs the file present.
# GitHub secret scanning will still flag it (it can't see the restriction); close
# that alert as a false positive rather than removing the file.

# Local Claude Code permissions — machine-specific, not team state.
.claude/settings.local.json

# Backend (Spring Boot / Gradle / Maven)
backend/build/
backend/.gradle/
backend/target/
*.class

# Frontend (Next.js / Node)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
node_modules/

# Mobile (Flutter)
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ios/Pods/
mobile/**/GeneratedPluginRegistrant.*
# Generated from the .arb files by `flutter pub get` (pubspec `generate: true`).
mobile/lib/l10n/app_localizations*.dart

# IDE
.idea/
*.iml
.vscode/

# NOTE: .capybara/ is committed team state — do NOT ignore it.

# graphify — knowledge-graph output. GRAPH_REPORT.md is committed; the rest is
# regenerable local output (`/graphify` rebuilds it) and churns on every run.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
