# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
# Names only here — no real value belongs in this file.
#
# ADR 0009: there is no backend and no database container any more. The portal's variables
# (FIREBASE_*, *_EMULATOR_HOST) go in frontend/.env.local — Next.js reads only its own
# directory's .env files. PORTAL_ADMIN_PASSWORD and GOOGLE_APPLICATION_CREDENTIALS are for the
# scripts in firebase/: export them in the shell that runs them. The Flutter app takes no .env —
# it is configured by android/app/google-services.json and --dart-define (firebase/README.md).

# --- Firebase project ---
# NOT a secret — the project id is public. The portal and the scripts default to lifelinkkh.
FIREBASE_PROJECT_ID=lifelinkkh
# The Web API key for the project (console → Project settings). Identifies the project for
# Firebase Auth's REST API; not a secret either, but restrict it to the Identity Toolkit API
# in Google Cloud. Unused when FIREBASE_AUTH_EMULATOR_HOST is set.
# FIREBASE_API_KEY=

# --- emulators ---
# host:port of each; set all three to run the portal against `npm run emulators:app`.
# Leave all three unset for the real project — one left set points the portal at nothing.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# --- the real project from this machine (seed scripts, metrics) ---
# ABSOLUTE path to a service-account JSON, for `npm run seed -- --project lifelinkkh`,
# `seed:admin -- --project lifelinkkh` and `metrics -- --project lifelinkkh`. Never needed by
# the portal or the app. Put the file in secrets/ (gitignored).
#
# NEVER commit the JSON. It holds an RSA private key for the whole Firebase project; one that
# reaches git history has to be revoked in the console, and deleting the file afterwards does
# nothing.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/Desktop/LifeLinkKh/secrets/firebase-service-account.json

# --- portal admin (DEC-013, DEC-014) ---
# The password `npm run seed:admin` in firebase/ puts on the portal's one account, soborey
# (ADMIN). v1 has no hospital staff, so there is no second password.
#
# Rules: minimum 12 characters (shorter is refused, not silently accepted); unset means no
# admin is created; the value is never logged. A re-run keeps an existing password — pass
# --reset-passwords to rotate it to this value.
PORTAL_ADMIN_PASSWORD=
