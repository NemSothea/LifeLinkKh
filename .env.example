# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
# Names only here — no real value belongs in this file.

# --- postgres ---
POSTGRES_DB=lifelink
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# --- backend ---
# Set only if you run the backend outside compose. Inside compose these are
# derived from the postgres values above by docker-compose.yml.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifelink
# SPRING_DATASOURCE_USERNAME=change-me
# SPRING_DATASOURCE_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=local

# --- backend auth (M3) ---
# The backend container will not start without these two. That is deliberate:
# a default signing key or an unpinned token audience is a control that
# silently disables itself in the one environment where it matters.
#
# Signs our own session JWT. At least 32 bytes for HS256 — the backend refuses
# a shorter one at startup rather than at a user's first sign-in. Generate one
# per machine and never share it:  openssl rand -base64 32
JWT_SECRET=change-me
# The value pinned as `aud` and `iss` when verifying a Google ID token. From the
# Firebase console. NOT a secret — the project id is public — but it must be the
# real one, or a token minted for someone else's project would verify
# (TM-AUTH-001 S2).
FIREBASE_PROJECT_ID=change-me
# ABSOLUTE host path to the Firebase service-account JSON. Until the Firebase
# project exists this stays unset: the app boots normally and POST /auth/google
# answers 503 AUTH_PROVIDER_UNCONFIGURED.
#
# Put the file in secrets/ — that directory is gitignored, and scripts/dev-up.sh
# mounts the path named here into the backend read-only via
# docker-compose.firebase.yml. Relative paths do not work: compose resolves the
# mount source, not the container.
#
# NEVER commit the JSON. It holds an RSA private key for the whole Firebase
# project; one that reaches git history has to be revoked in the console, and
# deleting the file afterwards does nothing.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/Desktop/LifeLinkKh/secrets/firebase-service-account.json
# Defaults to http://localhost:3000 in compose. Never '*'.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Telegram sign-in (FR-AUTH-004, TM-AUTH-002) ---
# All three blank until the bot exists (@BotFather). Until then every
# /auth/telegram/* endpoint answers 503 TELEGRAM_PROVIDER_UNCONFIGURED — every
# other endpoint works normally, same shape as GOOGLE_APPLICATION_CREDENTIALS above.
# TELEGRAM_BOT_TOKEN=
# The value passed to setWebhook's secret_token parameter when the webhook is
# registered — must match exactly, or Telegram's own calls get 401 (TM-AUTH-002 S1).
# TELEGRAM_WEBHOOK_SECRET=
# Without the @, e.g. LifeLinkKHBot — used to build the https://t.me/<bot>?start=...
# deep link the app opens.
# TELEGRAM_BOT_USERNAME=

# --- web ---
# Inside compose this is set to http://backend:8080/api by docker-compose.yml.
# API_BASE_URL=http://127.0.0.1:8080/api

# --- web portal auth ---
# Portal staff sign in at /<locale>/sign-in with a username and password (POST
# /auth/portal/login); the session JWT lands in an httpOnly cookie the browser cannot read.
#
# SET THESE TWO. No migration seeds a password any more — V19__unseed_portal_passwords.sql
# replaced the four seeded digests with hashes of random values nobody holds, because a
# password committed to a repository is a password everyone with the repository has, and one
# of those four accounts is the ADMIN that grants portal access and confirms donations.
#
# PortalPasswordBootstrap reads these at startup and writes the digests. Rules: minimum 12
# characters (shorter is refused and logged, not silently accepted); unset means those
# accounts simply cannot sign in; the values are never logged or echoed by any endpoint.
# Changing one here and restarting is also how you rotate.
#
#   PORTAL_ADMIN_PASSWORD -> soborey (ADMIN)
#   PORTAL_STAFF_PASSWORD -> calmette, tepi, july (HOSPITAL)
#
# One value for the three hospital accounts is a demo convenience, not a pattern to keep:
# each row still gets its own salted digest, but three people sharing one password is three
# people with one account. Revisit before anyone outside the team uses the portal.
PORTAL_ADMIN_PASSWORD=
PORTAL_STAFF_PASSWORD=
#
# PORTAL_DEV_JWT is gone. It was a token pasted in here by hand, shared by whoever had this
# file, owned by nobody and impossible to revoke from inside the product.
