# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
# Names only here — no real value belongs in this file.

# --- postgres ---
POSTGRES_DB=lifelink
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# --- backend ---
# Set only if you run the backend outside compose. Inside compose these are
# derived from the postgres values above by docker-compose.yml.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifelink
# SPRING_DATASOURCE_USERNAME=change-me
# SPRING_DATASOURCE_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=local

# --- backend auth (M3) ---
# The backend container will not start without these two. That is deliberate:
# a default signing key or an unpinned token audience is a control that
# silently disables itself in the one environment where it matters.
#
# Signs our own session JWT. At least 32 bytes for HS256 — the backend refuses
# a shorter one at startup rather than at a user's first sign-in. Generate one
# per machine and never share it:  openssl rand -base64 32
JWT_SECRET=change-me
# The value pinned as `aud` and `iss` when verifying a Google ID token. From the
# Firebase console. NOT a secret — the project id is public — but it must be the
# real one, or a token minted for someone else's project would verify
# (TM-AUTH-001 S2).
FIREBASE_PROJECT_ID=change-me
# ABSOLUTE host path to the Firebase service-account JSON. Until the Firebase
# project exists this stays unset: the app boots normally and POST /auth/google
# answers 503 AUTH_PROVIDER_UNCONFIGURED.
#
# Put the file in secrets/ — that directory is gitignored, and scripts/dev-up.sh
# mounts the path named here into the backend read-only via
# docker-compose.firebase.yml. Relative paths do not work: compose resolves the
# mount source, not the container.
#
# NEVER commit the JSON. It holds an RSA private key for the whole Firebase
# project; one that reaches git history has to be revoked in the console, and
# deleting the file afterwards does nothing.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/Desktop/LifeLinkKh/secrets/firebase-service-account.json
# Defaults to http://localhost:3000 in compose. Never '*'.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- web ---
# Inside compose this is set to http://backend:8080/api by docker-compose.yml.
# API_BASE_URL=http://127.0.0.1:8080/api

# --- web portal auth (temporary) ---
# No Firebase Web app is registered yet, so the portal has no Google Sign-In button —
# see docs/po/prototypes/web/PORTAL-open-requests/README.md. A session for the seeded
# HOSPITAL account (V8__portal_access.sql) minted directly with JWT_SECRET, not through
# POST /auth/google. Expires in one hour like any other session (ADR 0007) and has to be
# re-minted, not renewed. Server-side only — never rename this to start with
# NEXT_PUBLIC_, or the token ships in the browser bundle.
# PORTAL_DEV_JWT=change-me
