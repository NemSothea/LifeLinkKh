<?xml version="1.0" encoding="utf-8"?>
<!-- Khmer launcher label. "ជីវិត" (life) is the product's Khmer name and what the
     app bar shows; the Latin name is not transliterated because the brand is used
     as-is in Khmer copy. -->
<resources>
    <string name="app_name">ជីវិត</string>
    <!-- The notification channel's name and description in system Settings (MainActivity.kt).
         Android reads them in the device language when the channel is created. -->
    <string name="notification_channel_name">សំណើឈាម និងព័ត៌មានថ្មី</string>
    <string name="notification_channel_description">សំណើបន្ទាន់សម្រាប់ប្រភេទឈាមរបស់អ្នក និងព័ត៌មានអំពីសំណើដែលអ្នកបានដាក់</string>
</resources>
